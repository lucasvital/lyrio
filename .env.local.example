# ─────────────────────────────────────────────────────────────
# Lyrio Analytics Dashboard — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# --- Database (Neon Postgres or any Postgres connection string) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Base URL of the app (Vercel sets this automatically in prod; set for local)
AUTH_URL="http://localhost:3000"
# Google OAuth provider (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- PostHog (Cloud US) ---
# Personal API key: PostHog → Settings → Personal API Keys
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_BASE_URL="https://us.posthog.com"

# --- RevenueCat ---
# Secret API key (v2): RevenueCat → Project settings → API keys
REVENUECAT_API_KEY=""
REVENUECAT_PROJECT_ID=""
REVENUECAT_BASE_URL="https://api.revenuecat.com"

# --- Sync (cron protection) ---
# Shared secret required by /api/sync/* endpoints and Vercel Cron.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
